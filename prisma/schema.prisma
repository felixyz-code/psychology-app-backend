generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PSYCHOLOGIST
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
  ADJUSTMENT
  REFUND
}

enum FinancialTransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum FinancialTransactionCategory {
  SESSION
  ASSESSMENT
  MANUAL
  RENT
  UTILITIES
  SUPPLIES
  SOFTWARE
  SALARY
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  OTHER
}

enum OrganizationStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  ADMIN
  PSYCHOLOGIST
  RECEPTIONIST
  BILLING
  AUDITOR
  READ_ONLY
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PsychologistProfileStatus {
  LEGACY_UNVERIFIED
  ACTIVE
  SUSPENDED
}

enum PatientAssignmentRole {
  PRIMARY
  COLLABORATOR
  CONSULTING
}

enum PatientAssignmentStatus {
  ACTIVE
  ENDED
  REVOKED
}

enum PlanTier {
  FREE
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum BillingInterval {
  MONTHLY
  ANNUAL
  LIFETIME
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  MANUAL
  INTERNAL
  STRIPE
  MERCADOPAGO
}

enum EntitlementType {
  NUMERIC
  BOOLEAN
}

enum EntitlementCategory {
  CAPACITY
  FEATURE_FLAG
  INTEGRATION
  SUPPORT
}

enum UserTimeFormat {
  TWELVE_HOUR
  TWENTY_FOUR_HOUR
}

enum UserDateFormat {
  DD_MM_YYYY
  YYYY_MM_DD
  MM_DD_YYYY
}

enum AttachmentCategory {
  ESTUDIO_PREVIO
  REPORTE_ESCOLAR
  IDENTIFICACION
  OTRO
}

model User {
  id                              String                     @id @default(uuid()) @db.Uuid
  name                            String                     @db.VarChar(150)
  email                           String                     @unique @db.VarChar(255)
  normalizedEmail                 String                     @unique @db.VarChar(255)
  passwordHash                    String                     @map("password") @db.VarChar(255)
  role                            UserRole
  preferredOrganizationId         String?                    @db.Uuid
  patients                        Patient[]
  sessionNotes                    SessionNote[]
  uploadedDocuments               Document[]
  caseFileAttachments             CaseFileAttachment[]       @relation("UserCaseFileAttachments")
  appointments                    Appointment[]
  financialTransactions           FinancialTransaction[]
  preferredOrganization           Organization?              @relation("UserPreferredOrganization", fields: [preferredOrganizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  memberships                     OrganizationMembership[]
  invitedOrganizationInvitations  OrganizationInvitation[]   @relation("OrganizationInvitationInvitedUser")
  acceptedOrganizationInvitations OrganizationInvitation[]   @relation("OrganizationInvitationAcceptedByUser")
  psychologistProfile             PsychologistProfile?
  preferences                     UserPreferences?
  auditLogs                       AuditLog[]
  branchAccesses                  UserBranchAccess[]
  assessmentAdministrations       AssessmentAdministration[] @relation("ProfessionalAssessments")
  scheduleBlocks                  ScheduleBlock[]            @relation("TherapistScheduleBlocks")
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt

  @@index([preferredOrganizationId])
  @@map("users")
}

model Organization {
  id                        String                     @id @default(uuid()) @db.Uuid
  slug                      String                     @unique @db.VarChar(100)
  legalName                 String                     @db.VarChar(255)
  displayName               String                     @db.VarChar(150)
  status                    OrganizationStatus         @default(PROVISIONING)
  timezone                  String                     @default("UTC") @db.VarChar(100)
  locale                    String                     @default("es-MX") @db.VarChar(20)
  currency                  String                     @default("MXN") @db.Char(3)
  tradeName                 String?                    @db.VarChar(150)
  taxId                     String?                    @db.VarChar(50)
  phone                     String?                    @db.VarChar(30)
  email                     String?                    @db.VarChar(255)
  website                   String?                    @db.VarChar(500)
  address                   String?                    @db.Text
  memberships               OrganizationMembership[]
  invitations               OrganizationInvitation[]
  settings                  OrganizationSettings?
  branding                  OrganizationBranding?
  logoAsset                 OrganizationLogoAsset?
  preferredByUsers          User[]                     @relation("UserPreferredOrganization")
  patients                  Patient[]
  caseFiles                 CaseFile[]
  sessionNotes              SessionNote[]
  documents                 Document[]
  caseFileAttachments       CaseFileAttachment[]
  appointments              Appointment[]
  transactions              FinancialTransaction[]
  assignments               PatientAssignment[]
  auditLogs                 AuditLog[]
  subscriptions             Subscription[]
  branches                  Branch[]
  userBranchAccesses        UserBranchAccess[]
  corporateClients          CorporateClient[]
  paefAgreements            PaefAgreement[]
  benefitPools              BenefitPool[]
  employeeEligibilities     EmployeeEligibility[]
  benefitDebitLogs          BenefitDebitLog[]
  instruments               Instrument[]
  assessmentAdministrations AssessmentAdministration[]
  tenantInstrumentConfigs   TenantInstrumentConfig[]
  scheduleBlocks            ScheduleBlock[]
  notificationTemplates     NotificationTemplate[]
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(3)

  @@map("organizations")
}

model OrganizationMembership {
  id                      String              @id @default(uuid()) @db.Uuid
  organizationId          String              @db.Uuid
  userId                  String              @db.Uuid
  role                    MembershipRole
  status                  MembershipStatus    @default(INVITED)
  joinedAt                DateTime?           @db.Timestamptz(3)
  suspendedAt             DateTime?           @db.Timestamptz(3)
  revokedAt               DateTime?           @db.Timestamptz(3)
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                    User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  professionalAssignments PatientAssignment[] @relation("PatientAssignmentProfessional")
  createdAssignments      PatientAssignment[] @relation("PatientAssignmentCreatedBy")
  closedAssignments       PatientAssignment[] @relation("PatientAssignmentClosedBy")
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)

  @@index([organizationId, userId])
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, status, role])
  @@index([userId, status])
  @@map("organization_memberships")
}

model PsychologistProfile {
  id               String                    @id @default(uuid()) @db.Uuid
  userId           String                    @unique @db.Uuid
  professionalName String                    @db.VarChar(150)
  licenseNumber    String?                   @db.VarChar(100)
  phone            String?                   @db.VarChar(30)
  specialties      String[]                  @default([])
  bio              String?                   @db.Text
  status           PsychologistProfileStatus @default(LEGACY_UNVERIFIED)
  verifiedAt       DateTime?                 @db.Timestamptz(3)
  user             User                      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  avatarAsset      UserAvatarAsset?
  signatureAsset   UserSignatureAsset?
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(3)

  @@map("psychologist_profiles")
}

model UserAvatarAsset {
  userId      String              @id @db.Uuid
  storageKey  String              @unique @db.Text
  mimeType    String              @db.VarChar(100)
  byteSize    Int                 @db.Integer
  width       Int                 @db.Integer
  height      Int                 @db.Integer
  profile     PsychologistProfile @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  @@map("user_avatar_assets")
}

model UserSignatureAsset {
  userId      String              @id @db.Uuid
  storageKey  String              @unique @db.Text
  mimeType    String              @db.VarChar(100)
  byteSize    Int                 @db.Integer
  width       Int                 @db.Integer
  height      Int                 @db.Integer
  profile     PsychologistProfile @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  @@map("user_signature_assets")
}

model UserPreferences {
  userId                 String         @id @db.Uuid
  emailNotifications     Boolean        @default(true)
  inAppNotifications     Boolean        @default(true)
  appointmentReminders   Boolean        @default(true)
  reminderAdvanceMinutes Int            @default(60) @db.Integer
  sessionDigest          Boolean        @default(true)
  timeZone               String         @default("America/Mexico_City") @db.VarChar(100)
  timeFormat             UserTimeFormat @default(TWELVE_HOUR)
  dateFormat             UserDateFormat @default(DD_MM_YYYY)
  locale                 String         @default("es-MX") @db.VarChar(20)
  weekStartsOn           Int            @default(1) @db.SmallInt
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)

  @@map("user_preferences")
}

model OrganizationSettings {
  organizationId             String       @id @db.Uuid
  weekStartsOn               Int          @default(1)
  defaultAppointmentDuration Int?         @db.Integer
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt                  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime     @updatedAt @db.Timestamptz(3)

  @@map("organization_settings")
}

model OrganizationBranding {
  organizationId String       @id @db.Uuid
  visualName     String?      @db.VarChar(150)
  primaryColor   String?      @db.VarChar(7)
  accentColor    String?      @db.VarChar(7)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@map("organization_branding")
}

model OrganizationLogoAsset {
  organizationId String       @id @db.Uuid
  storageKey     String       @unique @db.Text
  mimeType       String       @db.VarChar(100)
  byteSize       Int          @db.Integer
  width          Int          @db.Integer
  height         Int          @db.Integer
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@map("organization_logo_assets")
}

model OrganizationInvitation {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  email            String         @db.VarChar(255)
  normalizedEmail  String         @db.VarChar(255)
  invitedUserId    String?        @db.Uuid
  role             MembershipRole
  tokenDigest      String         @unique @db.Char(64)
  expiresAt        DateTime       @db.Timestamptz(3)
  acceptedAt       DateTime?      @db.Timestamptz(3)
  acceptedByUserId String?        @db.Uuid
  rejectedAt       DateTime?      @db.Timestamptz(3)
  revokedAt        DateTime?      @db.Timestamptz(3)
  expiredAt        DateTime?      @db.Timestamptz(3)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitedUser      User?          @relation("OrganizationInvitationInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  acceptedByUser   User?          @relation("OrganizationInvitationAcceptedByUser", fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  @@index([organizationId, email])
  @@map("organization_invitations")
}

model Patient {
  id                        String                     @id @default(uuid()) @db.Uuid
  organizationId            String?                    @db.Uuid
  psychologistId            String                     @db.Uuid
  firstName                 String                     @db.VarChar(100)
  lastName                  String                     @db.VarChar(100)
  phoneNumber               String?                    @db.VarChar(30)
  email                     String?                    @db.VarChar(255)
  birthDate                 DateTime?                  @db.Date
  psychologist              User                       @relation(fields: [psychologistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization              Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  caseFile                  CaseFile?
  appointments              Appointment[]
  financialTransactions     FinancialTransaction[]
  assignments               PatientAssignment[]
  assessmentAdministrations AssessmentAdministration[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([psychologistId])
  @@index([organizationId, createdAt])
  @@map("patients")
}

model CaseFile {
  id                        String                     @id @default(uuid()) @db.Uuid
  organizationId            String?                    @db.Uuid
  patientId                 String                     @unique @db.Uuid
  diagnosis                 String?                    @db.Text
  treatmentPlan             String?                    @db.Text
  patient                   Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization              Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessionNotes              SessionNote[]
  documents                 Document[]
  attachments               CaseFileAttachment[]
  assessmentAdministrations AssessmentAdministration[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([organizationId, createdAt])
  @@map("case_files")
}

model SessionNote {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  caseFileId     String        @db.Uuid
  authorId       String        @db.Uuid
  sessionDate    DateTime
  title          String?       @db.VarChar(150)
  content        String        @db.Text
  caseFile       CaseFile      @relation(fields: [caseFileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author         User          @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([caseFileId])
  @@index([authorId])
  @@index([sessionDate])
  @@index([organizationId, sessionDate])
  @@map("session_notes")
}

model Document {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  caseFileId     String        @db.Uuid
  uploadedById   String        @db.Uuid
  fileName       String        @db.VarChar(255)
  filePath       String        @db.Text
  mimeType       String?       @db.VarChar(100)
  caseFile       CaseFile      @relation(fields: [caseFileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploadedBy     User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadedAt     DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([caseFileId])
  @@index([uploadedById])
  @@index([organizationId, uploadedAt])
  @@map("documents")
}

model CaseFileAttachment {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String?            @db.Uuid
  caseFileId     String             @db.Uuid
  uploadedById   String             @db.Uuid
  fileName       String             @db.VarChar(255)
  originalName   String             @db.VarChar(255)
  mimeType       String             @db.VarChar(100)
  sizeBytes      Int
  category       AttachmentCategory @default(OTRO)
  notes          String?            @db.Text
  filePath       String             @db.Text
  caseFile       CaseFile           @relation(fields: [caseFileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploadedBy     User               @relation("UserCaseFileAttachments", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([caseFileId])
  @@index([uploadedById])
  @@index([organizationId, createdAt])
  @@index([category])
  @@map("case_file_attachments")
}

model Appointment {
  id                    String                 @id @default(uuid()) @db.Uuid
  organizationId        String?                @db.Uuid
  patientId             String                 @db.Uuid
  psychologistId        String                 @db.Uuid
  scheduledAt           DateTime
  durationMinutes       Int
  status                AppointmentStatus      @default(SCHEDULED)
  notes                 String?                @db.Text
  patient               Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  psychologist          User                   @relation(fields: [psychologistId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  financialTransactions FinancialTransaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([patientId])
  @@index([psychologistId])
  @@index([scheduledAt])
  @@index([organizationId, scheduledAt])
  @@map("appointments")
}

model FinancialTransaction {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String?                      @db.Uuid
  type           FinancialTransactionType
  status         FinancialTransactionStatus   @default(PENDING)
  category       FinancialTransactionCategory @default(OTHER)
  amount         Decimal                      @db.Decimal(10, 2)
  currency       String                       @default("MXN") @db.VarChar(3)
  concept        String                       @db.VarChar(255)
  description    String?                      @db.Text
  occurredAt     DateTime
  dueDate        DateTime?
  paymentMethod  PaymentMethod?
  notes          String?                      @db.Text
  patientId      String?                      @db.Uuid
  appointmentId  String?                      @db.Uuid
  createdById    String                       @db.Uuid
  patient        Patient?                     @relation(fields: [patientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  appointment    Appointment?                 @relation(fields: [appointmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy      User                         @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization   Organization?                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@index([type])
  @@index([status])
  @@index([category])
  @@index([occurredAt])
  @@index([patientId])
  @@index([appointmentId])
  @@index([createdById])
  @@index([organizationId, occurredAt])
  @@map("financial_transactions")
}

model PatientAssignment {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @db.Uuid
  patientId             String                  @db.Uuid
  membershipId          String                  @db.Uuid
  role                  PatientAssignmentRole
  status                PatientAssignmentStatus @default(ACTIVE)
  startedAt             DateTime                @default(now()) @db.Timestamptz(3)
  endedAt               DateTime?               @db.Timestamptz(3)
  creationReason        String?                 @db.VarChar(500)
  closureReason         String?                 @db.VarChar(500)
  createdByMembershipId String?                 @db.Uuid
  closedByMembershipId  String?                 @db.Uuid
  version               Int                     @default(1)
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  patient               Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership            OrganizationMembership  @relation("PatientAssignmentProfessional", fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByMembership   OrganizationMembership? @relation("PatientAssignmentCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  closedByMembership    OrganizationMembership? @relation("PatientAssignmentClosedBy", fields: [closedByMembershipId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)

  @@index([organizationId, patientId, status])
  @@index([organizationId, membershipId, status])
  @@map("patient_assignments")
}

enum AuditSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model AuditLog {
  id              String        @id @default(uuid()) @db.Uuid
  timestamp       DateTime      @default(now()) @db.Timestamptz(3)
  organizationId  String?       @db.Uuid
  branchId        String?       @db.Uuid
  userId          String?       @db.Uuid
  action          String        @db.VarChar(100)
  resourceType    String        @db.VarChar(100)
  resourceId      String?       @db.VarChar(255)
  severity        AuditSeverity @default(INFO)
  ipAddress       String?       @db.VarChar(100)
  userAgent       String?       @db.Text
  statusCode      Int?
  executionTimeMs Int?
  actorRole       String?       @db.VarChar(50)
  details         Json?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId, timestamp])
  @@index([organizationId, severity, timestamp])
  @@index([organizationId, branchId, timestamp])
  @@index([userId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Plan {
  id              String            @id @default(uuid()) @db.Uuid
  tier            PlanTier
  code            String            @unique @db.VarChar(50)
  name            String            @db.VarChar(100)
  description     String?           @db.Text
  billingInterval BillingInterval   @default(MONTHLY)
  basePrice       Decimal           @default(0.00) @db.Decimal(10, 2)
  currency        String            @default("MXN") @db.Char(3)
  trialDays       Int               @default(0) @db.Integer
  isActive        Boolean           @default(true)
  isPublic        Boolean           @default(true)
  sortOrder       Int               @default(0) @db.Integer
  metadata        Json?
  subscriptions   Subscription[]
  entitlements    PlanEntitlement[]
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  @@index([tier, isActive])
  @@index([isPublic, sortOrder])
  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @db.Uuid
  planId                 String             @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  externalProvider       PaymentProvider    @default(MANUAL)
  externalSubscriptionId String?            @db.VarChar(255)
  externalCustomerId     String?            @db.VarChar(255)
  trialStartedAt         DateTime?          @db.Timestamptz(3)
  trialEndsAt            DateTime?          @db.Timestamptz(3)
  currentPeriodStartedAt DateTime           @default(now()) @db.Timestamptz(3)
  currentPeriodEndsAt    DateTime           @db.Timestamptz(3)
  gracePeriodEndsAt      DateTime?          @db.Timestamptz(3)
  canceledAt             DateTime?          @db.Timestamptz(3)
  endedAt                DateTime?          @db.Timestamptz(3)
  seatQuantity           Int                @default(1) @db.Integer
  cancelReason           String?            @db.VarChar(500)
  metadata               Json?
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  @@index([organizationId, status])
  @@index([status, currentPeriodEndsAt])
  @@index([externalProvider, externalSubscriptionId])
  @@index([externalCustomerId])
  @@map("subscriptions")
}

model EntitlementDefinition {
  id               String              @id @default(uuid()) @db.Uuid
  key              String              @unique @db.VarChar(100)
  name             String              @db.VarChar(150)
  description      String?             @db.Text
  type             EntitlementType
  category         EntitlementCategory @default(FEATURE_FLAG)
  defaultValue     Json
  planEntitlements PlanEntitlement[]
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  @@index([category])
  @@map("entitlement_definitions")
}

model PlanEntitlement {
  id                      String                @id @default(uuid()) @db.Uuid
  planId                  String                @db.Uuid
  entitlementDefinitionId String                @db.Uuid
  numericValue            Int?                  @db.Integer
  booleanValue            Boolean?
  metadata                Json?
  plan                    Plan                  @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  definition              EntitlementDefinition @relation(fields: [entitlementDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt               DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([planId, entitlementDefinitionId])
  @@index([entitlementDefinitionId])
  @@map("plan_entitlements")
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(120)
  code           String    @db.VarChar(30)
  address        String?   @db.VarChar(255)
  phone          String?   @db.VarChar(30)
  timezone       String    @default("UTC") @db.VarChar(50)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userAccesses              UserBranchAccess[]
  benefitDebitLogs          BenefitDebitLog[]
  auditLogs                 AuditLog[]
  assessmentAdministrations AssessmentAdministration[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, deletedAt])
  @@map("branches")
}

model UserBranchAccess {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([organizationId, userId])
  @@index([branchId])
  @@map("user_branch_accesses")
}

enum PaefAgreementStatus {
  DRAFT
  ACTIVE
  PAUSED
  TERMINATED
  EXPIRED
}

enum BenefitPoolStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  CANCELLED
}

enum EmployeeEligibilityStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum BenefitDebitStatus {
  RESERVED
  CONFIRMED
  RELEASED
  REFUNDED
}

enum BenefitDebitType {
  SESSION_BOOKING
  MANUAL_ADJUSTMENT
  SESSION_CANCEL_REFUND
}

model CorporateClient {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String   @db.VarChar(150)
  commercialName  String?  @map("commercial_name") @db.VarChar(150)
  taxId           String?  @map("tax_id") @db.VarChar(50)
  contactEmail    String?  @map("contact_email") @db.VarChar(255)
  contactPhone    String?  @map("contact_phone") @db.VarChar(30)
  domainWhitelist String[] @default([]) @map("domain_whitelist")
  notes           String?  @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agreements   PaefAgreement[]

  @@index([organizationId, isActive])
  @@index([organizationId, name])
  @@map("corporate_clients")
}

model PaefAgreement {
  id                            String              @id @default(uuid()) @db.Uuid
  organizationId                String              @map("organization_id") @db.Uuid
  corporateClientId             String              @map("corporate_client_id") @db.Uuid
  code                          String              @db.VarChar(50)
  title                         String              @db.VarChar(150)
  description                   String?             @db.Text
  status                        PaefAgreementStatus @default(ACTIVE)
  isMultiBranch                 Boolean             @default(true) @map("is_multi_branch")
  allowedBranchIds              String[]            @default([]) @map("allowed_branch_ids")
  defaultMaxSessionsPerEmployee Int                 @default(5) @map("default_max_sessions_per_employee")
  validFrom                     DateTime            @map("valid_from") @db.Timestamptz(3)
  validUntil                    DateTime            @map("valid_until") @db.Timestamptz(3)
  createdAt                     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  corporateClient       CorporateClient       @relation(fields: [corporateClientId], references: [id], onDelete: Restrict)
  benefitPools          BenefitPool[]
  employeeEligibilities EmployeeEligibility[]
  debitLogs             BenefitDebitLog[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([corporateClientId])
  @@index([validFrom, validUntil])
  @@map("paef_agreements")
}

model BenefitPool {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  agreementId      String            @map("agreement_id") @db.Uuid
  name             String            @db.VarChar(120)
  totalSessions    Int               @map("total_sessions")
  consumedSessions Int               @default(0) @map("consumed_sessions")
  reservedSessions Int               @default(0) @map("reserved_sessions")
  status           BenefitPoolStatus @default(ACTIVE)
  validFrom        DateTime          @map("valid_from") @db.Timestamptz(3)
  validUntil       DateTime          @map("valid_until") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agreement    PaefAgreement     @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  debitLogs    BenefitDebitLog[]

  @@index([agreementId, status])
  @@index([organizationId, status])
  @@map("benefit_pools")
}

model EmployeeEligibility {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @map("organization_id") @db.Uuid
  agreementId        String                    @map("agreement_id") @db.Uuid
  email              String                    @db.VarChar(255)
  employeeNumber     String?                   @map("employee_number") @db.VarChar(60)
  nationalId         String?                   @map("national_id") @db.VarChar(60)
  firstName          String?                   @map("first_name") @db.VarChar(100)
  lastName           String?                   @map("last_name") @db.VarChar(100)
  department         String?                   @db.VarChar(100)
  maxSessionsAllowed Int                       @map("max_sessions_allowed")
  consumedSessions   Int                       @default(0) @map("consumed_sessions")
  reservedSessions   Int                       @default(0) @map("reserved_sessions")
  status             EmployeeEligibilityStatus @default(ACTIVE)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agreement    PaefAgreement     @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  debitLogs    BenefitDebitLog[]

  @@unique([agreementId, email])
  @@index([agreementId, email])
  @@index([organizationId, email])
  @@index([agreementId, employeeNumber])
  @@map("employee_eligibilities")
}

model BenefitDebitLog {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  agreementId     String             @map("agreement_id") @db.Uuid
  poolId          String             @map("pool_id") @db.Uuid
  eligibilityId   String?            @map("eligibility_id") @db.Uuid
  branchId        String?            @map("branch_id") @db.Uuid
  appointmentId   String?            @map("appointment_id") @db.Uuid
  patientId       String?            @map("patient_id") @db.Uuid
  userId          String?            @map("user_id") @db.Uuid
  transactionType BenefitDebitType   @map("transaction_type")
  sessionQuantity Int                @default(1) @map("session_quantity")
  status          BenefitDebitStatus
  reason          String?            @db.VarChar(255)
  metadata        Json?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agreement    PaefAgreement        @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  pool         BenefitPool          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  eligibility  EmployeeEligibility? @relation(fields: [eligibilityId], references: [id], onDelete: SetNull)
  branch       Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([agreementId])
  @@index([poolId])
  @@index([eligibilityId])
  @@index([appointmentId])
  @@map("benefit_debit_logs")
}

enum InstrumentVersionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

model Instrument {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String?  @map("organization_id") @db.Uuid
  code             String   @db.VarChar(50)
  name             String   @db.VarChar(150)
  description      String?  @db.Text
  targetPopulation String?  @map("target_population") @db.VarChar(150)
  isSystem         Boolean  @default(false) @map("is_system")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions      InstrumentVersion[]
  tenantConfigs TenantInstrumentConfig[]

  @@unique([organizationId, code])
  @@index([organizationId, isSystem])
  @@index([code, isSystem])
  @@map("instruments")
}

model TenantInstrumentConfig {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  instrumentId   String       @map("instrument_id") @db.Uuid
  isEnabled      Boolean      @default(true) @map("is_enabled")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instrument     Instrument   @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, instrumentId])
  @@index([organizationId, isEnabled])
  @@index([instrumentId])
  @@map("tenant_instrument_configs")
}

model InstrumentVersion {
  id              String                  @id @default(uuid()) @db.Uuid
  instrumentId    String                  @map("instrument_id") @db.Uuid
  versionNumber   Int                     @default(1) @map("version_number")
  status          InstrumentVersionStatus @default(DRAFT)
  definitionJson  Json                    @map("definition_json")
  scoringSpecJson Json                    @map("scoring_spec_json")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt     DateTime?               @map("published_at") @db.Timestamptz(3)

  instrument                Instrument                 @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  assessmentAdministrations AssessmentAdministration[]

  @@unique([instrumentId, versionNumber])
  @@index([instrumentId, status])
  @@map("instrument_versions")
}

enum AdministrationStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

model AssessmentAdministration {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  branchId            String?              @map("branch_id") @db.Uuid
  patientId           String               @map("patient_id") @db.Uuid
  professionalId      String               @map("professional_id") @db.Uuid
  caseFileId          String?              @map("case_file_id") @db.Uuid
  instrumentVersionId String               @map("instrument_version_id") @db.Uuid
  status              AdministrationStatus @default(ASSIGNED)
  accessToken         String?              @unique @map("access_token") @db.VarChar(128)
  expiresAt           DateTime?            @map("expires_at") @db.Timestamptz(3)
  startedAt           DateTime?            @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime?            @map("completed_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional      User              @relation("ProfessionalAssessments", fields: [professionalId], references: [id], onDelete: Restrict)
  caseFile          CaseFile?         @relation(fields: [caseFileId], references: [id], onDelete: SetNull)
  instrumentVersion InstrumentVersion @relation(fields: [instrumentVersionId], references: [id], onDelete: Restrict)

  responses AssessmentResponse[]
  result    AssessmentResult?

  @@index([organizationId, status])
  @@index([patientId, status])
  @@index([professionalId, status])
  @@index([caseFileId])
  @@index([instrumentVersionId])
  @@index([accessToken])
  @@index([organizationId, createdAt])
  @@map("assessment_administrations")
}

model AssessmentResponse {
  id               String   @id @default(uuid()) @db.Uuid
  administrationId String   @map("administration_id") @db.Uuid
  itemCode         String   @map("item_code") @db.VarChar(50)
  responseValue    Json     @map("response_value")
  numericWeight    Float?   @map("numeric_weight")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  administration AssessmentAdministration @relation(fields: [administrationId], references: [id], onDelete: Cascade)

  @@unique([administrationId, itemCode])
  @@index([administrationId])
  @@map("assessment_responses")
}

model AssessmentResult {
  id                      String   @id @default(uuid()) @db.Uuid
  administrationId        String   @unique @map("administration_id") @db.Uuid
  rawScore                Float    @map("raw_score")
  normalizedScore         Float?   @map("normalized_score")
  strataCode              String?  @map("strata_code") @db.VarChar(50)
  strataTitle             String?  @map("strata_title") @db.VarChar(150)
  severity                String?  @map("severity") @db.VarChar(50)
  subscaleScoresJson      Json?    @map("subscale_scores_json")
  flagsJson               Json?    @map("flags_json")
  scoringSpecSnapshotJson Json     @map("scoring_spec_snapshot_json")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  administration AssessmentAdministration @relation(fields: [administrationId], references: [id], onDelete: Cascade)

  @@index([administrationId])
  @@map("assessment_results")
}

model ScheduleBlock {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  therapistId    String        @db.Uuid
  title          String        @db.VarChar(150)
  reason         String?       @db.Text
  startTime      DateTime      @db.Timestamptz(3)
  endTime        DateTime      @db.Timestamptz(3)
  therapist      User          @relation("TherapistScheduleBlocks", fields: [therapistId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  @@index([organizationId, therapistId])
  @@index([therapistId, startTime, endTime])
  @@index([startTime, endTime])
  @@map("schedule_blocks")
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationEventType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER_24H
  APPOINTMENT_REMINDER_2H
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
}

model NotificationTemplate {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  channel        NotificationChannel
  eventType      NotificationEventType @map("event_type")
  name           String                @db.VarChar(150)
  subject        String?               @db.VarChar(255)
  body           String                @db.Text
  variables      Json?
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, channel, eventType])
  @@index([organizationId, channel])
  @@index([organizationId, eventType])
  @@index([organizationId, isActive])
  @@map("notification_templates")
}

