{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "resolvePackageJsonExports": false,
    "incremental": false
  },
  "include": [
    "prisma/seed.ts",
    "prisma/seed-certification.ts",
    "prisma/seeds/**/*.ts",
    "prisma/backfill/**/*.ts",
    "src/prisma/legacy-backfill/**/*.ts"
  ]
}
